generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
model User {
  id              String         @id @default(uuid()) @db.Uuid
  username        String         @db.VarChar(32)
  usernameKey     String         @unique @db.VarChar(32)
  email           String         @db.VarChar(254)
  emailKey        String         @unique @db.VarChar(254)
  passwordHash    String         @db.VarChar(255)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  trainer         Trainer?
  sessions        Session[]
  tokens          AccountToken[]
}
model Trainer {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String   @db.VarChar(32)
  avatarUrl     String?
  level         Int      @default(1)
  experience    Int      @default(0)
  onboardingAt  DateTime?
  locationId    String   @default("pallet-town")
  location      Location @relation(fields: [locationId], references: [id])
  pokedollars   Int      @default(0)
  starter       StarterSelection?
  cards         PokemonInstance[] @relation("Owner")
  originalCards PokemonInstance[] @relation("OriginalTrainer")
  dex           PokedexEntry[]
  inventory     InventoryEntry[]
  tutorial      TutorialProgress?
  unlocks       PlayerLocationUnlock[]
  rewards       RewardGrant[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique @db.VarChar(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
model AccountToken {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    AccountTokenPurpose
  tokenHash  String              @unique @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model EmailDelivery {
  id            String   @id @default(uuid()) @db.Uuid
  payload       String
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil    DateTime?
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([sentAt, nextAttemptAt])
}

enum CardOrigin {
  STARTER_PACK
  POKEMON_PACK
  CAUGHT
}
enum PokemonNature {
  HARDY
  LONELY
  BRAVE
  ADAMANT
  NAUGHTY
  BOLD
  DOCILE
  RELAXED
  IMPISH
  LAX
  TIMID
  HASTY
  SERIOUS
  JOLLY
  NAIVE
  MODEST
  MILD
  QUIET
  BASHFUL
  RASH
  CALM
  GENTLE
  SASSY
  CAREFUL
  QUIRKY
}
enum DexStatus {
  SEEN
  CAPTURED
}
model Location {
  id       String @id
  name     String
  trainers Trainer[]
  unlocks  PlayerLocationUnlock[]
}
model PokemonSpecies {
  id               Int @id
  name             String
  types            String[]
  baseStats        Json
  abilities        String[]
  moves            String[]
  imageUrl         String
  imagePlaceholder Boolean @default(true)
  cards            PokemonInstance[]
  packs            PackDefinition[]
  dex              PokedexEntry[]
}
model PackDefinition {
  id        String @id
  name      String
  element   String
  speciesId Int
  species   PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  selections StarterSelection[]
}
model PokemonInstance {
  id                String @id @default(uuid()) @db.Uuid
  speciesId         Int
  species           PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  ownerId           String @db.Uuid
  owner             Trainer @relation("Owner", fields: [ownerId], references: [id], onDelete: Restrict)
  originalTrainerId String @db.Uuid
  originalTrainer   Trainer @relation("OriginalTrainer", fields: [originalTrainerId], references: [id], onDelete: Restrict)
  originalTrainerName String
  level             Int @default(5)
  experience        Int @default(0)
  hpCurrent         Int
  stats             Json
  abilities         String[]
  moves             String[]
  origin            CardOrigin @default(STARTER_PACK)
  ivs               Json @default("{\"hp\":0,\"attack\":0,\"defense\":0,\"specialAttack\":0,\"specialDefense\":0,\"speed\":0}")
  evs               Json @default("{\"hp\":0,\"attack\":0,\"defense\":0,\"specialAttack\":0,\"specialDefense\":0,\"speed\":0}")
  nature            PokemonNature @default(HARDY)
  activeAbility     String?
  originBall        String @default("POKE_BALL")
  tier              String @default("COMMON")
  originLocation    String @default("Pallet Town")
  originDescription String @default("Pokémon Inicial — Presente do Professor Oak")
  capturedAt        DateTime @default(now())
  history           Json
  starter           StarterSelection?

  @@index([ownerId])
  @@index([speciesId])
}
model StarterSelection {
  trainerId String @id @db.Uuid
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  packId    String
  pack      PackDefinition @relation(fields: [packId], references: [id], onDelete: Restrict)
  cardId    String @unique @db.Uuid
  card      PokemonInstance @relation(fields: [cardId], references: [id], onDelete: Restrict)
  chosenAt  DateTime @default(now())
}
model PokedexEntry {
  trainerId String @db.Uuid
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  speciesId Int
  species   PokemonSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  status    DexStatus
  firstSeenAt DateTime @default(now())
  capturedAt DateTime?

  @@id([trainerId, speciesId])
}
model ItemDefinition {
  id       String @id
  name     String
  category String
  entries  InventoryEntry[]
}
model InventoryEntry {
  trainerId String @db.Uuid
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  itemId    String
  item      ItemDefinition @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity  Int @default(0)

  @@id([trainerId, itemId])
}
model TutorialProgress {
  trainerId       String @id @db.Uuid
  trainer         Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  dialogIndex     Int @default(0)
  oakDone         Boolean @default(false)
  revealed        Boolean @default(false)
  detailsViewed   Boolean @default(false)
  collectionVisited Boolean @default(false)
  dexVisited      Boolean @default(false)
  mapVisited      Boolean @default(false)
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt
}
model PlayerLocationUnlock {
  trainerId String @db.Uuid
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  unlockedAt DateTime @default(now())

  @@id([trainerId, locationId])
}
model RewardGrant {
  trainerId String @db.Uuid
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  key       String
  grantedAt DateTime @default(now())

  @@id([trainerId, key])
}
