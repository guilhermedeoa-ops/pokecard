{
  "name": "pokecard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @pokecard/web",
    "dev:api": "npm run dev -w @pokecard/api",
    "build": "npm run build -w @pokecard/shared && npm run build -w @pokecard/api && npm run build -w @pokecard/web",
    "db:validate": "npm run db:validate -w @pokecard/api",
    "db:generate": "npm run db:generate -w @pokecard/api",
    "db:migrate": "npm run db:migrate -w @pokecard/api",
    "test:integration": "npm run test:integration -w @pokecard/api"
  }
}